# Server configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shiksha_setu
# If MONGODB_URI is unreachable in dev, server can fallback to in-memory MongoDB
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=super-secret-jwt-key-for-shiksha-setu-demo-min-32-chars
JWT_EXPIRES_IN=7d

# Document Encryption 
DOC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS Client URL
CLIENT_URL=http://localhost:3000

# AI Provider (gemini | openai | none)
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
